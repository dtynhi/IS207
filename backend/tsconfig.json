{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext", 
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "moduleResolution": "NodeNext", 
    "resolveJsonModule": true
  },
  "include": ["src/**/*"]
}