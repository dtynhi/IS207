generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  active
  inactive
}

enum OrderStatus {
  pending_confirm
  ready_to_pick
  ready_to_ship
  delivered
  awaiting_return
  returned
  cancelled
  completed
}

enum PaymentStatus {
  unpaid
  paid
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
}

enum WalletTransactionType {
  credit
  debit
}

enum RefundEventType {
  cancel_refund
  return_refund
}

enum RefundRequestStatus {
  pending
  completed
  failed
}

enum ReturnRequestStatus {
  pending
  approved
  rejected
}

enum CouponType {
  percent
  amount
}

enum VoucherMode {
  PUBLIC
  PRIVATE
  LIMITED
}

enum VoucherRefundPolicy {
  NONE
  ON_CANCEL
  ON_RETURN
}

model Role {
  id          String       @id @default(cuid())
  title       String
  description String?
  permissions Json?
  status      RecordStatus @default(active)
  deleted     Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  accounts Account[]
}

model Account {
  id        String       @id @default(cuid())
  fullName  String
  email     String       @unique
  password  String
  phone     String?
  avatar    String?
  status    RecordStatus @default(active)
  roleId    String?
  isSeeded  Boolean      @default(false)
  deleted   Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  role                   Role?           @relation(fields: [roleId], references: [id])
  assignedOrders         Order[]         @relation("OrderAssignee")
  returnLogs             ReturnLog[]
  reviewedReturnRequests ReturnRequest[] @relation("ReturnRequestReviewer")
}

model User {
  id        String       @id @default(cuid())
  fullName  String
  email     String       @unique
  password  String
  tokenUser String?
  phone     String?
  avatar    String?
  address   Json?
  status    RecordStatus @default(active)
  isSeeded  Boolean      @default(false)
  deleted   Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  carts              Cart[]
  orders             Order[]
  wallet             Wallet?
  returnRequests     ReturnRequest[]
  voucherUsages      VoucherUsage[]
  voucherAssignments VoucherAssignment[]
}

model ProductCategory {
  id          String       @id @default(cuid())
  title       String
  description String?
  parentId    String?
  position    Int          @default(0)
  thumbnail   String?
  slug        String       @unique
  status      RecordStatus @default(active)
  deleted     Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryTree")
  products Product[]
}

model Product {
  id                 String           @id @default(cuid())
  title              String
  description        String?
  price              Int
  discountPercentage Int              @default(0)
  stock              Int              @default(0)
  thumbnail          String?
  images             Json?
  slug               String           @unique
  school             String?
  brand              String?
  position           Int              @default(0)
  featured           Boolean          @default(false)
  status             RecordStatus     @default(active)
  deleted            Boolean          @default(false)
  productCategoryId  String?
  createdById        String?
  deletedById        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  soldCount          Int              @default(0)
  productCategory    ProductCategory? @relation(fields: [productCategoryId], references: [id])
  carts              Cart[]
  orderItems         OrderItem[]

  dailyFlashSaleId String?
  dailyFlashSale   DailyFlashSale? @relation(fields: [dailyFlashSaleId], references: [id])
  
  campaignId       String?
  saleCampaign     SaleCampaign?   @relation(fields: [campaignId], references: [id])
}

model Cart {
  id        String   @id @default(cuid())
  userId    String?
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User?   @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

model Order {
  id                  String        @id @default(cuid())
  userId              String?
  couponId            String?
  fullName            String
  phone               String
  address             String
  couponCode          String?
  originalAmount      Int           @default(0)
  discountAmount      Int           @default(0)
  finalAmount         Int           @default(0)
  status              OrderStatus   @default(pending_confirm)
  paymentStatus       PaymentStatus @default(unpaid)
  paymentMethod       PaymentMethod @default(COD)
  assignedToAccountId String?
  assignedAt          DateTime?
  lockVersion         Int           @default(0)
  deliveredAt         DateTime?
  completedAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  user               User?               @relation(fields: [userId], references: [id])
  coupon             Coupon?             @relation(fields: [couponId], references: [id])
  assignedToAccount  Account?            @relation("OrderAssignee", fields: [assignedToAccountId], references: [id])
  items              OrderItem[]
  statusLogs         OrderStatusLog[]
  returnLog          ReturnLog?
  returnRequest      ReturnRequest?
  refundRequests     RefundRequest[]
  walletTransactions WalletTransaction[]
  orderVouchers      OrderVoucher[]
}

model OrderItem {
  id                 String @id @default(cuid())
  orderId            String
  productId          String
  price              Int
  discountPercentage Int    @default(0)
  quantity           Int    @default(1)

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model OrderVoucher {
  id         String   @id @default(cuid())
  orderId    String
  voucherId  String
  discount   Int      @default(0)
  createdAt  DateTime @default(now())

  order   Order  @relation(fields: [orderId], references: [id])
  voucher Coupon @relation(fields: [voucherId], references: [id])

  @@unique([orderId, voucherId])
}

model VoucherUsage {
  id         String   @id @default(cuid())
  voucherId  String
  userId     String
  usedCount  Int      @default(0)
  firstUsedAt DateTime?
  lastUsedAt  DateTime?

  voucher Coupon @relation(fields: [voucherId], references: [id])
  user    User   @relation(fields: [userId], references: [id])

  @@unique([voucherId, userId])
}

model VoucherAssignment {
  id           String   @id @default(cuid())
  voucherId    String
  userId       String
  grantedById  String?
  grantedAt    DateTime @default(now())
  allowedUses  Int?
  extraUses    Int?
  expiresAt    DateTime?
  note         String?

  voucher Coupon @relation(fields: [voucherId], references: [id])
  user    User   @relation(fields: [userId], references: [id])

  @@unique([voucherId, userId])
}

model OrderStatusLog {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  reason     String?
  actorType  String?
  actorId    String?
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

model ReturnLog {
  id                   String   @id @default(cuid())
  orderId              String   @unique
  result               String
  reason               String?
  restocked            Boolean  @default(false)
  processedByAccountId String?
  processedAt          DateTime @default(now())

  order              Order    @relation(fields: [orderId], references: [id])
  processedByAccount Account? @relation(fields: [processedByAccountId], references: [id])
}

model ReturnRequest {
  id                  String              @id @default(cuid())
  orderId             String              @unique
  userId              String
  reason              String
  description         String?
  mediaUrls           Json?
  status              ReturnRequestStatus @default(pending)
  reviewedByAccountId String?
  reviewedAt          DateTime?
  reviewReason        String?
  createdAt           DateTime            @default(now())

  order             Order    @relation(fields: [orderId], references: [id])
  user              User     @relation(fields: [userId], references: [id])
  reviewedByAccount Account? @relation("ReturnRequestReviewer", fields: [reviewedByAccountId], references: [id])
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]
}

model WalletTransaction {
  id        String                @id @default(cuid())
  walletId  String
  orderId   String?
  type      WalletTransactionType
  amount    Int
  reason    String?
  createdAt DateTime              @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])
  order  Order? @relation(fields: [orderId], references: [id])
}

model RefundRequest {
  id             String              @id @default(cuid())
  orderId        String
  eventType      RefundEventType
  amount         Int
  status         RefundRequestStatus @default(pending)
  idempotencyKey String              @unique
  createdAt      DateTime            @default(now())
  completedAt    DateTime?

  order Order @relation(fields: [orderId], references: [id])
}

model SettingGeneral {
  id          String   @id @default(cuid())
  websiteName String
  logo        String?
  phone       String?
  email       String?
  address     String?
  copyright   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ForgotPassword {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expireAt  DateTime
  createdAt DateTime @default(now())
}

model SaleCampaign {
  id        String   @id @default(uuid())
  name      String // Tên sự kiện
  startTime DateTime // Thời gian bắt đầu
  endTime   DateTime // Thời gian kết thúc
  bannerUrl String? // ảnh banner
  discount  Int // Mức % giảm giá chung cho chiến dịch
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model DailyFlashSale {
  id        String   @id @default(uuid())
  startTime DateTime // Giờ bắt đầu ca Flash Sale
  endTime   DateTime // Giờ kết thúc ca Flash Sale
  status    String   @default("UPCOMING") // 3 Trạng thái: UPCOMING (Sắp chạy), ONGOING (Đang chạy), ENDED (Đã xong)

  products Product[]
}

model Coupon {
  id                  String              @id @default(cuid())
  code                String              @unique
  description         String?
  type                CouponType          @default(percent)
  value               Int                 // Phần trăm hoặc số tiền
  startsAt            DateTime?
  endsAt              DateTime?
  totalUsageLimit     Int?                // null = unlimited
  usedCount           Int                 @default(0)
  maxUsagePerUser     Int?                // null = unlimited
  mode                VoucherMode         @default(PUBLIC)
  allowStacking       Boolean             @default(false)
  maxVouchersPerOrder Int?                // null = default 1 voucher per order
  refundPolicy        VoucherRefundPolicy @default(NONE)
  minOrderAmount      Int                 @default(0)
  applyTo             Json?               // Danh sách product IDs hoặc rules
  status              RecordStatus        @default(active)
  createdById         String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  orders              Order[]
  usages              VoucherUsage[]
  assignments         VoucherAssignment[]
  orderVouchers       OrderVoucher[]

  @@index([status])
  @@index([endsAt])
}
