generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  active
  inactive
}

enum OrderStatus {
  pending_confirm
  ready_to_pick
  ready_to_ship
  delivered
  returned
  cancelled
}

enum PaymentStatus {
  unpaid
  paid
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
}

model Role {
  id          String   @id @default(cuid())
  title       String
  description String?
  permissions Json?
  status      RecordStatus @default(active)
  deleted     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  accounts    Account[]
}

model Account {
  id          String   @id @default(cuid())
  fullName    String
  email       String   @unique
  password    String
  phone       String?
  avatar      String?
  status      RecordStatus @default(active)
  roleId      String?
  isSeeded    Boolean  @default(false)
  deleted     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  role           Role?    @relation(fields: [roleId], references: [id])
  assignedOrders Order[]  @relation("OrderAssignee")
  returnLogs     ReturnLog[]
}

model User {
  id          String   @id @default(cuid())
  fullName    String
  email       String   @unique
  password    String
  tokenUser   String?
  phone       String?
  avatar      String?
  address     Json?
  status      RecordStatus @default(active)
  isSeeded    Boolean  @default(false)
  deleted     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  carts       Cart[]
  orders      Order[]
}

model ProductCategory {
  id          String   @id @default(cuid())
  title       String
  description String?
  parentId    String?
  position    Int      @default(0)
  thumbnail   String?
  slug        String   @unique
  status      RecordStatus @default(active)
  deleted     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent      ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    ProductCategory[] @relation("CategoryTree")
  products    Product[]
}

model Product {
  id                String   @id @default(cuid())
  title             String
  description       String?
  price             Int
  discountPercentage Int     @default(0)
  stock             Int      @default(0)
  thumbnail         String?
  images            Json?
  slug              String   @unique
  school            String?
  brand             String?
  position          Int      @default(0)
  featured          Boolean  @default(false)
  status            RecordStatus @default(active)
  deleted           Boolean  @default(false)
  productCategoryId String?
  createdById       String?
  deletedById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  productCategory   ProductCategory? @relation(fields: [productCategoryId], references: [id])
  carts             Cart[]
  orderItems        OrderItem[]
}

model Cart {
  id          String   @id @default(cuid())
  userId      String?
  productId   String
  quantity    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User?    @relation(fields: [userId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

model Order {
  id                  String        @id @default(cuid())
  userId              String?
  fullName            String
  phone               String
  address             String
  status              OrderStatus   @default(pending_confirm)
  paymentStatus       PaymentStatus @default(unpaid)
  paymentMethod       PaymentMethod @default(COD)
  assignedToAccountId String?
  assignedAt          DateTime?
  lockVersion         Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  user              User?     @relation(fields: [userId], references: [id])
  assignedToAccount Account?  @relation("OrderAssignee", fields: [assignedToAccountId], references: [id])
  items             OrderItem[]
  statusLogs        OrderStatusLog[]
  returnLog         ReturnLog?
}

model OrderItem {
  id                 String @id @default(cuid())
  orderId            String
  productId          String
  price              Int
  discountPercentage Int    @default(0)
  quantity           Int    @default(1)

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model OrderStatusLog {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  reason     String?
  actorType  String?
  actorId    String?
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

model ReturnLog {
  id                  String   @id @default(cuid())
  orderId             String   @unique
  result              String
  reason              String?
  restocked           Boolean  @default(false)
  processedByAccountId String?
  processedAt         DateTime @default(now())

  order             Order    @relation(fields: [orderId], references: [id])
  processedByAccount Account? @relation(fields: [processedByAccountId], references: [id])
}

model SettingGeneral {
  id          String   @id @default(cuid())
  websiteName String
  logo        String?
  phone       String?
  email       String?
  address     String?
  copyright   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ForgotPassword {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expireAt  DateTime
  createdAt DateTime @default(now())
}
